{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/lib/store": ["./src/renderer/store-ipc.ts"],
      "@/pages/settings": ["./src/renderer/pages/settings-desktop.tsx"],
      "@/*": ["../progress-journal/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
